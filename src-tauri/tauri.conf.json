{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lalos POS",
  "version": "0.2.7",
  "identifier": "com.lalosburgas.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lalo's POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "center": true,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: https://*.supabase.co https://lalos-burgers.pages.dev",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      },
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Business",
    "shortDescription": "Caja y cocina de Lalo's Burgas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMzBBMzdFMEM3QjI1MjUKUldRbEpYc01mcU13VWxsK0VxUlMzZ3J1djFabFFRdlh6RXFyUjRVTm8wZnZ1MmpUMGNrY0RLU2cK",
      "endpoints": [
        "https://github.com/alvarogubilattouxui-sudo/lalos-pos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
